# All-in configuration: copy this file to .env and fill it in (`setup.cmd -Dev` does that for you).
# .env holds the bot token and database passwords, so it is never committed.

# Discord application, from the Developer Portal. Required.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: deploy:commands registers the slash commands in this server only, which is instant.
DEV_GUILD_ID=

# PostgreSQL, as postgresql://user:password@host:5432/database. Required.
DATABASE_URL=
# Tests only: a separate database that the tests wipe. Its name must end in _test.
TEST_DATABASE_URL=

# Optional: the daily gift resets at midnight in this time zone.
DAILY_RESET_TIMEZONE=Europe/Amsterdam
# Optional: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

